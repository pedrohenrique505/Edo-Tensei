From: Edo-Tensei <edo-tensei@local>
Subject: [PATCH] ps2xRecomp: fix VSQI/VSQD fs/it operands, vi0/vf0 guards and VU0 Data RAM base

In VU0 macro mode, `VSQI fs, (it++)` and `VSQD fs, (--it)` encode `fs` in `rd`
and `it` in `rt` (opposite of `VLQI`/`VLQD`), and all four instructions access
VU0 Data RAM (`0x11004000`, 4 KiB) rather than low RDRAM `0x00000000`.
Previously `VSQI $vf0, ($vi1++)` wrote `$vf1` to RDRAM and incremented `$vi0`.
---
 ps2xRecomp/src/lib/vu_translation_helpers.cpp | 60 ++++++++++++++-------------
 1 file changed, 32 insertions(+), 28 deletions(-)

diff --git a/ps2xRecomp/src/lib/vu_translation_helpers.cpp b/ps2xRecomp/src/lib/vu_translation_helpers.cpp
--- a/ps2xRecomp/src/lib/vu_translation_helpers.cpp
+++ b/ps2xRecomp/src/lib/vu_translation_helpers.cpp
@@ -765,59 +765,63 @@ namespace ps2recomp
     std::string CodeGenerator::translateVU_VLQI(const Instruction &inst)
     {
         uint8_t vis = inst.rd;
+        uint8_t ft = inst.rt;
         uint8_t dest_mask = inst.vectorInfo.vectorField;
-        return fmt::format("{{ uint32_t addr = ((uint32_t)(ctx->vi[{}] & 0x3FF)) << 4; "
-                           "__m128 res = _mm_castsi128_ps(READ128(addr)); "
-                           "__m128i mask = _mm_set_epi32({}, {}, {}, {}); "
-                           "ctx->vu0_vf[{}] = _mm_blendv_ps(ctx->vu0_vf[{}], res, _mm_castsi128_ps(mask)); "
-                           "ctx->vi[{}] = (ctx->vi[{}] + 1) & 0x3FF; }}",
-                           vis,
-                           (dest_mask & 0x1) ? -1 : 0, (dest_mask & 0x2) ? -1 : 0,
-                           (dest_mask & 0x4) ? -1 : 0, (dest_mask & 0x8) ? -1 : 0,
-                           inst.rt, inst.rt,
-                           vis, vis);
+        std::string inc = (vis != 0) ? fmt::format(" ctx->vi[{}] = (ctx->vi[{}] + 1) & 0xFFFF;", vis, vis) : "";
+        std::string store = (ft != 0)
+            ? fmt::format("__m128i mask = _mm_set_epi32({}, {}, {}, {}); "
+                          "ctx->vu0_vf[{}] = _mm_blendv_ps(ctx->vu0_vf[{}], res, _mm_castsi128_ps(mask));",
+                          (dest_mask & 0x1) ? -1 : 0, (dest_mask & 0x2) ? -1 : 0,
+                          (dest_mask & 0x4) ? -1 : 0, (dest_mask & 0x8) ? -1 : 0,
+                          ft, ft)
+            : "(void)res;";
+        return fmt::format("{{ uint32_t addr = 0x11004000u + (((uint32_t)(ctx->vi[{}] & 0xFF)) << 4); "
+                           "__m128 res = _mm_castsi128_ps(READ128(addr)); {}{} }}",
+                           vis, store, inc);
     }
 
     std::string CodeGenerator::translateVU_VSQI(const Instruction &inst)
     {
-        uint8_t vis = inst.rd;
+        // VSQI fs, (it++): fs is in rd, it is in rt (opposite of VLQI).
+        uint8_t fs = inst.rd;
+        uint8_t vit = inst.rt;
         uint8_t dest_mask = inst.vectorInfo.vectorField;
-        return fmt::format("{{ uint32_t addr = ((uint32_t)(ctx->vi[{}] & 0x3FF)) << 4; "
+        std::string inc = (vit != 0) ? fmt::format(" ctx->vi[{}] = (ctx->vi[{}] + 1) & 0xFFFF;", vit, vit) : "";
+        return fmt::format("{{ uint32_t addr = 0x11004000u + (((uint32_t)(ctx->vi[{}] & 0xFF)) << 4); "
                            "__m128i old_val = READ128(addr); "
                            "__m128 res = _mm_blendv_ps(_mm_castsi128_ps(old_val), ctx->vu0_vf[{}], _mm_castsi128_ps(_mm_set_epi32({}, {}, {}, {}))); "
-                           "WRITE128(addr, _mm_castps_si128(res)); "
-                           "ctx->vi[{}] = (ctx->vi[{}] + 1) & 0x3FF; }}",
-                           vis,
-                           inst.rt,
+                           "WRITE128(addr, _mm_castps_si128(res));{} }}",
+                           vit, fs,
                            (dest_mask & 0x1) ? -1 : 0, (dest_mask & 0x2) ? -1 : 0,
                            (dest_mask & 0x4) ? -1 : 0, (dest_mask & 0x8) ? -1 : 0,
-                           vis, vis);
+                           inc);
     }
 
     std::string CodeGenerator::translateVU_VLQD(const Instruction &inst)
     {
         uint8_t vis = inst.rd;
+        uint8_t ft = inst.rt;
         uint8_t dest_mask = inst.vectorInfo.vectorField;
-        return fmt::format("{{ ctx->vi[{}] = (ctx->vi[{}] - 1) & 0x3FF; "
-                           "uint32_t addr = ((uint32_t)(ctx->vi[{}] & 0x3FF)) << 4; "
-                           "__m128 res = _mm_castsi128_ps(READ128(addr)); "
-                           "__m128i mask = _mm_set_epi32({}, {}, {}, {}); "
-                           "ctx->vu0_vf[{}] = _mm_blendv_ps(ctx->vu0_vf[{}], res, _mm_castsi128_ps(mask)); }}",
-                           vis, vis,
-                           vis,
-                           (dest_mask & 0x1) ? -1 : 0, (dest_mask & 0x2) ? -1 : 0,
-                           (dest_mask & 0x4) ? -1 : 0, (dest_mask & 0x8) ? -1 : 0,
-                           inst.rt, inst.rt);
+        std::string dec = (vis != 0) ? fmt::format("ctx->vi[{}] = (ctx->vi[{}] - 1) & 0xFFFF; ", vis, vis) : "";
+        std::string store = (ft != 0)
+            ? fmt::format("__m128i mask = _mm_set_epi32({}, {}, {}, {}); "
+                          "ctx->vu0_vf[{}] = _mm_blendv_ps(ctx->vu0_vf[{}], res, _mm_castsi128_ps(mask));",
+                          (dest_mask & 0x1) ? -1 : 0, (dest_mask & 0x2) ? -1 : 0,
+                          (dest_mask & 0x4) ? -1 : 0, (dest_mask & 0x8) ? -1 : 0,
+                          ft, ft)
+            : "(void)res;";
+        return fmt::format("{{ {}uint32_t addr = 0x11004000u + (((uint32_t)(ctx->vi[{}] & 0xFF)) << 4); "
+                           "__m128 res = _mm_castsi128_ps(READ128(addr)); {} }}",
+                           dec, vis, store);
     }
 
     std::string CodeGenerator::translateVU_VSQD(const Instruction &inst)
     {
-        uint8_t vis = inst.rd;
+        // VSQD fs, (--it): fs is in rd, it is in rt (opposite of VLQD).
+        uint8_t fs = inst.rd;
+        uint8_t vit = inst.rt;
         uint8_t dest_mask = inst.vectorInfo.vectorField;
-        return fmt::format("{{ ctx->vi[{}] = (ctx->vi[{}] - 1) & 0x3FF; "
-                           "uint32_t addr = ((uint32_t)(ctx->vi[{}] & 0x3FF)) << 4; "
+        std::string dec = (vit != 0) ? fmt::format("ctx->vi[{}] = (ctx->vi[{}] - 1) & 0xFFFF; ", vit, vit) : "";
+        return fmt::format("{{ {}uint32_t addr = 0x11004000u + (((uint32_t)(ctx->vi[{}] & 0xFF)) << 4); "
                            "__m128i old_val = READ128(addr); "
                            "__m128 res = _mm_blendv_ps(_mm_castsi128_ps(old_val), ctx->vu0_vf[{}], _mm_castsi128_ps(_mm_set_epi32({}, {}, {}, {}))); "
                            "WRITE128(addr, _mm_castps_si128(res)); }}",
-                           vis, vis,
-                           vis,
-                           inst.rt,
+                           dec, vit, fs,
                            (dest_mask & 0x1) ? -1 : 0, (dest_mask & 0x2) ? -1 : 0,
                            (dest_mask & 0x4) ? -1 : 0, (dest_mask & 0x8) ? -1 : 0);
     }
