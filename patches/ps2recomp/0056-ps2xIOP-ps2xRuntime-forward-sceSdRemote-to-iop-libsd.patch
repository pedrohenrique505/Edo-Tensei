+    uint32_t IopLibsd::handleRemote(uint32_t cmd,
+                                    uint32_t arg0,
+                                    uint32_t arg1,
+                                    uint32_t arg2,
+                                    uint32_t arg3,
+                                    uint32_t arg4,
+                                    uint64_t currentCycle)
+    {
+        auto ensureMixScheduled = [&]() {
+            if (m_nextMixCycle == UINT64_MAX)
+                m_nextMixCycle = currentCycle + kCyclesPerMixChunk;
+        };
+
+        switch (cmd)
+        {
+        case 0x8010u: // rSdSetParam(entry, value)
+            setParam(static_cast<uint16_t>(arg0), static_cast<uint16_t>(arg1));
+            return 0u;
+
+        case 0x8020u: // rSdGetParam(entry)
+            return getParam(static_cast<uint16_t>(arg0));
+
+        case 0x80E0u: // rSdBlockTrans(ch, mode, mAddr, size, startAddr)
+        {
+            const uint32_t ch = arg0 & 1u;
+            const uint32_t mode = arg1 & 0x03u;
+            const bool loop = (arg1 & 0x10u) != 0u;
+            const uint32_t mAddr = arg2;
+            const uint32_t size = arg3;
+            DmaChannel &dma = m_dma[ch];
+
+            if (mode == 2u) // SD_TRANS_MODE_STOP
+            {
+                const uint32_t curAddr = dma.blockActive ? (dma.blockAddr + dma.blockPosFrames * 4u) : 0u;
+                const uint32_t status = dma.blockActive
+                                            ? ((dma.blockHalfIndex << 24u) | (curAddr & 0x00FFFFFFu))
+                                            : 0u;
+                dma.blockActive = false;
+                dma.blockLoop = false;
+                return status;
+            }
+
+            if (mode == 0u || mode == 3u) // SD_TRANS_MODE_WRITE / SD_TRANS_MODE_WRITE_FROM
+            {
+                if (size < 1024u)
+                    return static_cast<uint32_t>(-1);
+                dma.blockAddr = mAddr;
+                dma.blockSize = size;
+                dma.blockTotalFrames = size / 4u;
+                dma.blockHalfFrames = dma.blockTotalFrames / 2u;
+                dma.blockPosFrames = 0u;
+                if (mode == 3u && arg4 >= mAddr && arg4 < mAddr + size)
+                    dma.blockPosFrames = (arg4 - mAddr) / 4u;
+                dma.blockHalfIndex = (dma.blockPosFrames >= dma.blockHalfFrames) ? 1u : 0u;
+                dma.blockLoop = loop;
+                dma.blockActive = true;
+                m_initialized = true;
+                ensureMixScheduled();
+                return 0u;
+            }
+            return 0u;
+        }
+
+        case 0x8100u: // rSdBlockTransStatus(ch, flag)
+        {
+            const uint32_t ch = arg0 & 1u;
+            const DmaChannel &dma = m_dma[ch];
+            if (!dma.blockActive)
+                return 0u;
+            const uint32_t curAddr = dma.blockAddr + dma.blockPosFrames * 4u;
+            return (dma.blockHalfIndex << 24u) | (curAddr & 0x00FFFFFFu);
+        }
+
+        default:
+            return 0u;
+        }
+    }
