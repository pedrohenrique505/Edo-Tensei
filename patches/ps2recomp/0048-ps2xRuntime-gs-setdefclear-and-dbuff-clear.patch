From: Edo-Tensei <edo-tensei@local>
Subject: [PATCH] ps2xRuntime: implement sceGsSetDefClear and populate clear0/clear1 in sceGsSetDefDBuff

`sceGsSetDefClear` was a no-op and `sceGsSetDefDBuff` ignored the `clear` flag
(and read trailing args from the stack instead of EABI64 registers `$t0-$t2`),
leaving `clear0`/`clear1` zeroed so neither the framebuffer nor the Z-buffer
was cleared between frames. Populate both `GsClearMem` packets and honor
`giftag.NLOOP` in `sceGsSwapDBuff`.
---
 ps2xRuntime/src/lib/Kernel/Stubs/GS.cpp | 68 +++++++++++++++++++++++++++------
 1 file changed, 57 insertions(+), 11 deletions(-)

diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/GS.cpp b/ps2xRuntime/src/lib/Kernel/Stubs/GS.cpp
--- a/ps2xRuntime/src/lib/Kernel/Stubs/GS.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/GS.cpp
@@ -872,12 +872,54 @@ namespace ps2_stubs
         setReturnS32(ctx, 0);
     }
 
+    static void seedGsClear(GsClearMem &clr, uint32_t ztest,
+                            int32_t x, int32_t y, int32_t w, int32_t h,
+                            uint8_t r, uint8_t g, uint8_t b, uint8_t a, uint32_t z)
+    {
+        clr.testa = {0x30000ULL, 0x47ULL};
+        clr.prim = {6ULL, 0x00ULL};
+        clr.rgbaq = {
+            static_cast<uint64_t>(r) |
+                (static_cast<uint64_t>(g) << 8) |
+                (static_cast<uint64_t>(b) << 16) |
+                (static_cast<uint64_t>(a) << 24) |
+                (0x3F800000ULL << 32),
+            0x01ULL};
+        const uint64_t x0 = static_cast<uint64_t>(static_cast<uint32_t>(x << 4) & 0xFFFFu);
+        const uint64_t y0 = static_cast<uint64_t>(static_cast<uint32_t>(y << 4) & 0xFFFFu);
+        const uint64_t x1 = static_cast<uint64_t>(static_cast<uint32_t>((x + w) << 4) & 0xFFFFu);
+        const uint64_t y1 = static_cast<uint64_t>(static_cast<uint32_t>((y + h) << 4) & 0xFFFFu);
+        const uint64_t zv = static_cast<uint64_t>(z) << 32;
+        clr.xyz2a = {x0 | (y0 << 16) | zv, 0x05ULL};
+        clr.xyz2b = {x1 | (y1 << 16) | zv, 0x05ULL};
+        const uint64_t testb = (ztest == 0u)
+                                   ? 0x30000ULL
+                                   : (0x10000ULL | (static_cast<uint64_t>(ztest & 3u) << 17));
+        clr.testb = {testb, 0x47ULL};
+    }
+
     void sceGsSetDefClear(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
     {
-        (void)rdram;
-        (void)ctx;
         (void)runtime;
-        setReturnS32(ctx, 0);
+        const uint32_t clrAddr = getRegU32(ctx, 4);
+        const uint32_t ztest = getRegU32(ctx, 5) & 0xFFFFu;
+        const int32_t x = static_cast<int16_t>(getRegU32(ctx, 6) & 0xFFFFu);
+        const int32_t y = static_cast<int16_t>(getRegU32(ctx, 7) & 0xFFFFu);
+        const int32_t w = static_cast<int16_t>(getRegU32(ctx, 8) & 0xFFFFu);
+        const int32_t h = static_cast<int16_t>(getRegU32(ctx, 9) & 0xFFFFu);
+        const uint8_t r = static_cast<uint8_t>(getRegU32(ctx, 10) & 0xFFu);
+        const uint8_t g = static_cast<uint8_t>(getRegU32(ctx, 11) & 0xFFu);
+        const uint8_t b = static_cast<uint8_t>(readStackU32(rdram, ctx, 0) & 0xFFu);
+        const uint8_t a = static_cast<uint8_t>(readStackU32(rdram, ctx, 8) & 0xFFu);
+        const uint32_t z = readStackU32(rdram, ctx, 16);
+
+        GsClearMem clr{};
+        seedGsClear(clr, ztest, x, y, w, h, r, g, b, a, z);
+        if (uint8_t *ptr = getMemPtr(rdram, clrAddr))
+        {
+            std::memcpy(ptr, &clr, sizeof(clr));
+        }
+        setReturnS32(ctx, 6);
     }
 
     void sceGsSetDefDBuffDc(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
@@ -957,10 +999,10 @@ namespace ps2_stubs
         uint32_t psm = getRegU32(ctx, 5);
         uint32_t w = getRegU32(ctx, 6);
         uint32_t h = getRegU32(ctx, 7);
-        const uint32_t ztest = readStackU32(rdram, ctx, 16);
-        const uint32_t zpsm = readStackU32(rdram, ctx, 20);
-        const uint32_t clear = readStackU32(rdram, ctx, 24);
-        (void)clear;
+        const GsTrailingArgs3 trailing = decodeGsTrailingArgs3(rdram, ctx);
+        const uint32_t ztest = trailing.arg0;
+        const uint32_t zpsm = trailing.arg1;
+        const uint32_t clear = trailing.arg2;
 
         if (w == 0u)
         {
@@ -997,10 +1039,17 @@ namespace ps2_stubs
         db.disp[0].bgcolor = 0u;
         db.disp[1] = db.disp[0];
 
-        db.giftag0 = {makeGiftagAplusD(14u), 0x0E0E0E0E0E0E0E0EULL};
+        db.giftag0 = {makeGiftagAplusD(clear != 0u ? 14u : 8u), 0x0E0E0E0E0E0E0E0EULL};
         seedGsDrawEnv1(db.draw0, drawWidth, drawHeight, 0u, fbw, psm, zbufAddr, zpsm, ztest, false);
         db.giftag1 = db.giftag0;
         seedGsDrawEnv1(db.draw1, drawWidth, drawHeight, 0u, fbw, psm, zbufAddr, zpsm, ztest, false);
+        if (clear != 0u)
+        {
+            const int32_t cx = 0x800 - (drawWidth >> 1);
+            const int32_t cy = 0x800 - (drawHeight >> 1);
+            seedGsClear(db.clear0, ztest, cx, cy, drawWidth, drawHeight, 0u, 0u, 0u, 0u, 0u);
+            seedGsClear(db.clear1, ztest, cx, cy, drawWidth, drawHeight, 0u, 0u, 0u, 0u, 0u);
+        }
 
         if (!writeGsDBuff(rdram, envAddr, db))
         {
@@ -1215,11 +1264,13 @@ namespace ps2_stubs
         applyGsDispEnv(runtime, db.disp[which]);
         if (which == 0u)
         {
-            applyGsRegPairs(runtime, reinterpret_cast<const GsRegPairMem *>(&db.draw0), 8u);
+            const uint32_t nloop = std::min<uint32_t>(static_cast<uint32_t>(db.giftag0.lo & 0x7FFFu), 14u);
+            applyGsRegPairs(runtime, reinterpret_cast<const GsRegPairMem *>(&db.draw0), nloop > 0u ? nloop : 8u);
         }
         else
         {
-            applyGsRegPairs(runtime, reinterpret_cast<const GsRegPairMem *>(&db.draw1), 8u);
+            const uint32_t nloop = std::min<uint32_t>(static_cast<uint32_t>(db.giftag1.lo & 0x7FFFu), 14u);
+            applyGsRegPairs(runtime, reinterpret_cast<const GsRegPairMem *>(&db.draw1), nloop > 0u ? nloop : 8u);
         }
 
         setReturnS32(ctx, static_cast<int32_t>(which ^ 1u));
